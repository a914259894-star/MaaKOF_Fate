{
    "interface_version": 2,
    "name": "MaaKOF_Fate",
    "title": "MaaKOF_Fate 竞技场自动化",
    "description": "基于 MaaFramework 的格斗手游竞技场自动化：快速选人 → 战斗（技能循环 + 普攻 + 替身识别）→ 结算确认 → 按所选模式自动循环。坐标以 1280x720 为基准，适配 16:9 安卓模拟器（MuMu 2560x1440 实测）。",
    "version": "1.0.0",
    "welcome": "# 使用前必读\n\n- 请从游戏**主界面**开始运行（竞技场任务）\n- 模拟器分辨率建议 2560x1440（16:9 均可），输入方式由 MaaFramework 自动选择\n- 「战斗·单场」仅在**已进入战斗画面**时使用，它会立刻开始盲点技能按钮\n- 「竞技场·大师」需要已解锁大师竞技场\n- 依赖：电脑需安装 Python 并 `pip install maafw==5.5.0 opencv-python`",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "arena_1v1",
            "label": "竞技场·1v1 循环",
            "entry": "Arena_Enter_1v1",
            "default_check": true,
            "option": [
                "快速选人"
            ],
            "description": "从主界面进入竞技场 → 1v1 → 选人 → 战斗 → 结算点确认 → 回竞技区自动开下一场，循环直到手动停止"
        },
        {
            "name": "arena_master",
            "label": "竞技场·大师 循环",
            "entry": "Arena_Enter_Master",
            "option": [
                "快速选人"
            ],
            "description": "需要已解锁大师竞技场。大师模式循环：结算后回竞技区自动再进大师场",
            "pipeline_override": {
                "Arena_LeaveSettle": {
                    "next": [
                        "Arena_WaitBattle",
                        "Arena_Mode_Master",
                        "Arena_Enter_Master"
                    ]
                }
            }
        },
        {
            "name": "fight_once",
            "label": "战斗·单场挂机",
            "entry": "Fight_Once",
            "description": "不进出竞技场，从当前画面直接打完一场：技能循环 + 普攻 + 替身识别 + 结算识别。⚠️ 仅在已进入战斗画面时勾选（入口为 DirectHit，会立刻开始点击）"
        }
    ],
    "option": {
        "快速选人": {
            "type": "select",
            "label": "快速选人",
            "description": "开启 = 点「近期使用」最左一列三人（需游戏内已开启快速选人功能）。\n关闭 = 按角色模板选人，栏仅支持 1~3（picks 为 [[1,1,1],[1,2,1],[1,3,1]]，即第1栏上中下三个）。",
            "cases": [
                {
                    "name": "开启",
                    "label": "开启（推荐）",
                    "pipeline_override": {
                        "Arena_Pick": {
                            "custom_action_param": {
                                "quick_pick": true
                            }
                        }
                    }
                },
                {
                    "name": "关闭",
                    "label": "关闭（用模板选人）",
                    "pipeline_override": {
                        "Arena_Pick": {
                            "custom_action_param": {
                                "quick_pick": false,
                                "picks": [
                                    [
                                        1,
                                        1,
                                        1
                                    ],
                                    [
                                        2,
                                        1,
                                        1
                                    ],
                                    [
                                        3,
                                        1,
                                        1
                                    ]
                                ]
                            }
                        }
                    }
                }
            ]
        }
    }
}