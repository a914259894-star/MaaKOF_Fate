{
    "interface_version": 2,
    "name": "MaaKOF_Fate",
    "title": "MaaKOF_Fate 竞技场自动化",
    "description": "基于 MaaFramework 的格斗手游竞技场自动化：快速选人 → 战斗（技能循环 + 普攻 + 替身识别）→ 结算确认 → 按所选模式自动循环。坐标以 1280x720 为基准，适配 16:9 安卓模拟器（MuMu 2560x1440 实测）。",
    "version": "1.0.0",
    "welcome": "# 使用前必读\n\n- 请从游戏**主界面**开始运行（竞技场任务）\n- 模拟器分辨率建议 2560x1440（16:9 均可），输入方式由 MaaFramework 自动选择\n- 「战斗·单场」仅在**已进入战斗画面**时使用，它会立刻开始盲点技能按钮\n- 「竞技场·大师」需要已解锁大师竞技场\n- **已内置便携 Python（含 maafw==5.5.0 + opencv），开箱即用，无需自行安装 Python。**\n- 如需改用本机 Python：把 interface.json 的 `agent.child_exec` 改回 `\"python\"`，并自行 `pip install -r assets/agent/requirements.txt`。",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "./libs/python/python.exe",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "arena_1v1",
            "label": "竞技场·1v1 循环",
            "entry": "Arena_Enter_1v1",
            "default_check": true,
            "option": [
                "快速选人",
                "误点退出延迟"
            ],
            "description": "从主界面进入竞技场 → 1v1 → 选人 → 战斗 → 结算点确认 → 回竞技区自动开下一场，循环直到手动停止"
        },
        {
            "name": "arena_master",
            "label": "竞技场·大师 循环",
            "entry": "Arena_Enter_Master",
            "option": [
                "快速选人",
                "误点退出延迟"
            ],
            "description": "需要已解锁大师竞技场。大师模式循环：结算后回竞技区自动再进大师场",
            "pipeline_override": {
                "Arena_LeaveSettle": {
                    "next": [
                        "Arena_WaitBattle",
                        "Arena_Mode_Master",
                        "Arena_Enter_Master"
                    ]
                }
            }
        },
        {
            "name": "fight_once",
            "label": "战斗·单场挂机",
            "entry": "Fight_Once",
            "option": [
                "误点退出延迟"
            ],
            "description": "不进出竞技场，从当前画面直接打完一场：技能循环 + 普攻 + 替身识别 + 结算识别。⚠️ 仅在已进入战斗画面时勾选（入口为 DirectHit，会立刻开始点击）"
        }
    ],
    "option": {
        "快速选人": {
            "type": "select",
            "label": "快速选人",
            "description": "开启 = 点「近期使用」最左一列三人（需游戏内已开启快速选人功能）。\n关闭 = 按角色模板选人（栏1~10、行/列1~3）。关闭后会出现「选人栏位」子选项，填 3 个角色（栏,行,列，如 1,1,1;2,1,1;3,1,1）。页面由栏位自动判定：全部栏≤3 → 第一页（不拖）；含栏≥8 → 最后一页（拖到尽头）；栏4~7 按比例拖。",
            "cases": [
                {
                    "name": "开启",
                    "label": "开启（推荐）",
                    "pipeline_override": {
                        "Arena_Pick": {
                            "custom_action_param": {
                                "quick_pick": true
                            }
                        }
                    }
                },
                {
                    "name": "关闭",
                    "label": "关闭（用模板选人）",
                    "pipeline_override": {
                        "Arena_Pick": {
                            "custom_action_param": {
                                "quick_pick": false
                            }
                        }
                    },
                    "option": [
                        "选人栏位"
                    ]
                }
            ]
        },
        "误点退出延迟": {
            "type": "input",
            "label": "误点退出延迟（毫秒）",
            "description": "战斗中检测到误入的界面（至尊赛/排行榜/玩家详情/商城）后，等待多少毫秒再点击返回退出。设备卡顿/模拟器掉帧导致退不出去时，可调大（如 2000）；返回点得太慢可调小（如 800）。默认 1200。",
            "inputs": [
                {
                    "name": "wrong_settle_ms",
                    "label": "延迟毫秒",
                    "default": "1200",
                    "pipeline_type": "int",
                    "verify": "^\\d{3,5}$",
                    "pattern_msg": "请输入 100~99999 之间的毫秒数（如 1200）"
                }
            ],
            "pipeline_override": {
                "Fight_Once": {
                    "custom_action_param": {
                        "duration": 900,
                        "interval": 0,
                        "skills": ["Fight_Substitute"],
                        "skill_cycle": ["skill1", "skill2", "skill3", "ult", "secret"],
                        "skill_tap": { "hold_ms": 30, "interval_ms": 30 },
                        "normal_tap": { "hold_ms": 30, "interval_ms": 30, "times": 3 },
                        "keep_moving": false,
                        "move_dir": [-1, 0],
                        "result_nodes": ["Fight_Lose"],
                        "result_interval": 4.0,
                        "wrong_threshold": 0.85,
                        "main_threshold": 0.8,
                        "back_xy": [1244, 28],
                        "user_close_xy": [843, 109],
                        "wrong_settle_ms": "{wrong_settle_ms}",
                        "wrong_max_layers": 12
                    }
                }
            }
        },
        "选人栏位": {
            "type": "input",
            "label": "选人栏位（栏,行,列）",
            "description": "常规选人时自定义 3 个角色。每行一个，逗号分隔 栏,行,列（栏1~10、行1~3、列1~3）。例：1,1,1;2,1,1;3,1,1。页面由栏位自动判定：栏全≤3 走第一页，含栏≥8 自动拖到最后一页。仅在「快速选人=关闭」时出现。",
            "inputs": [
                {
                    "name": "picks",
                    "label": "栏位",
                    "default": "1,1,1;2,1,1;3,1,1",
                    "pipeline_type": "string",
                    "verify": "^(\\d{1,2},\\d,\\d)(;\\d{1,2},\\d,\\d){2}$",
                    "pattern_msg": "格式应为 栏,行,列;栏,行,列;栏,行,列（如 1,1,1;2,1,1;3,1,1），栏1~10、行1~3、列1~3"
                }
            ],
            "pipeline_override": {
                "Arena_Pick": {
                    "custom_action_param": {
                        "quick_pick": false,
                        "picks": "{picks}"
                    }
                }
            }
        }
    }
}